\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv_style_academic}[2026/02/09 Academic style for unified markup]

% This style intentionally keeps the existing academic header layout.
% It expects TLCresume.sty to be loaded by the main document.

\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}

%-------------------------------------------------------------------------------
% List spacing
%-------------------------------------------------------------------------------
% TLCresume defines a tight zitemize environment; for the unified academic style
% we prefer a bit more breathing room between bullets.
% Default bullet spacing for this style.
\setlength{\cvitemssepdefault}{2pt}
\cvresetcvitemssep
\renewenvironment{zitemize}{%
  \begin{itemize}%
    \setlength{\topsep}{2pt}%
    \setlength{\itemsep}{\cvitemssep}%
    \setlength{\parsep}{0pt}%
    \setlength{\parskip}{0pt}%
}{%
  \end{itemize}%
  \vspace{0pt}%
}

\newcommand{\cvmakeheader}{%
    \fancypagestyle{first_page}{%
        \fancyhf{}%
        \lhead{%
            \phone\\%
            \city\\%
            \href{mailto:\email}{\email}%
        }%
        \chead{%
            \centering
            {\Huge \skills \name}\\%
            \vspace{.25em}%
            % The role/title can be long; keep it compact in academic header.
            {\color{highlight} \normalsize{\role}}%
        }%
        \rhead{%
            \ifx\portfoliourl\empty\else
            Portfolio: \href{\portfoliourl}{\portfolioname}\\%
            \fi
            \ifx\github\empty\else
            \href{https://github.com/\github}{github.com/\github}\\%
            \fi
            \ifx\LinkedIn\empty\else
            \href{https://www.linkedin.com/in/\LinkedIn}{linkedin.com/in/\LinkedIn}\\%
            \fi
            \ifx\huggingfaceurl\empty\else
            \href{\huggingfaceurl}{\cvHuggingFaceIcon\,\huggingfacelabel}%
            \fi
        }%
        % No horizontal rule under the academic header
        \renewcommand{\headrulewidth}{0pt}%
        \renewcommand{\headrule}{}%
        \setlength{\headheight}{90pt}%
        % Space between header and body (first page)
        % Keep this tight so the first section starts closer to the header.
        \setlength{\headsep}{6pt}%
    }%
    \fancypagestyle{others}{%
        \fancyhf{}%
        \renewcommand{\headrulewidth}{0pt}%
        \setlength{\headheight}{30pt}%
        \setlength{\headsep}{5pt}%
    }%
}

%----------------------
% Unified semantic markup -> TLCresume formatting
%----------------------
% Optional argument sets \cventrysep for this section:
%   \cvsection[0.6em]{Education}
\newcommand{\cvsection}[2][]{%
\ifstrempty{#1}{\cvresetcventrysep}{\cvsetcventrysep{#1}}%
\section{#2}}
\newcommand{\cvsubsection}[1]{
\subsection{#1}}

\newenvironment{cventries}{}{}

% Space between consecutive \cventry blocks
% (Defined in cv_core; override here if needed.)

\newcommand*{\cventry}[5]{%
    \subsection{\cvtexorpdfline{#1 \hfill #4}{#1 -- #4}}%
    \ifstrempty{#2#3}{}{\subtext{\cvtexorpdfline{#2 \hfill #3}{#2 -- #3}}}%
    #5%
    \vspace{\cventrysep}%
}

\newenvironment{cvitems}{
\begin{zitemize}}{
\end{zitemize}}

\newenvironment{cvparagraph}{\par\noindent}{\par\vspace{0.25em}}

\newenvironment{cvskills}{
\begin{tabular}{p{11em} p{1em} p{43em}}}{
\end{tabular}}
\newcommand*{\cvskill}[2]{\skills{#1} & & #2 \\}

% Education details (single line or list)
\newcommand{\cvedudetails}[1]{\textit{#1}\par}
% Space between items inside education details lists.
% By default, details lists inherit the current \cvitems spacing (including any
% per-section override via \cvsectionitemssep). Set \cvsetcvedudetailssep{<len>}
% to override only education details lists.
\newlength{\cvedudetailssep}
\newif\ifcvedudetailssepset
\cvedudetailssepsetfalse
\newcommand*{\cvsetcvedudetailssep}[1]{%
  \setlength{\cvedudetailssep}{#1}%
  \cvedudetailssepsettrue%
}
\newcommand*{\cvresetcvedudetailssep}{\cvedudetailssepsetfalse}
\newcommand*{\cvsectionedudetailssep}[1]{%
  \ifblank{#1}{\cvresetcvedudetailssep}{\cvsetcvedudetailssep{#1}}%
}

\newenvironment{cvedudetailslist}{%
  \begingroup%
  \ifcvedudetailssepset
    \cvsetcvitemssep{\cvedudetailssep}%
  \fi
  \begin{cvitems}%
}{%
  \end{cvitems}%
  \endgroup%
}
\newcommand{\cvedudetail}[1]{\item {#1}}

%----------------------
% Education-specific semantic macros
%----------------------
\newcommand*{\cveduentry}[5]{%
    \skills{#1}, \textit{#2} \hfill #4\par
    \ifstrempty{#5}{}{#5}%
    \vspace{0.25em}%
}

\newcommand*{\cvaward}[3]{%
    \textit{#1, #2} \hfill #3\par
    \vspace{0.25em}%
}

% Optional, for templates that reuse these names.
\newenvironment{cvhonors}{}{}
\newcommand*{\cvhonor}[4]{#1\par}
