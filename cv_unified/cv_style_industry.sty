\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv_style_industry}[2026/02/09 Industry style for unified markup]

% Awesome-CV-inspired style layer for the unified semantic markup.
% Not a 1:1 reimplementation; goal is "close" while keeping a single engine.

\RequirePackage{fontspec}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{parskip}
\RequirePackage{etoolbox}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{graphicx}
\RequirePackage{fontawesome}
\RequirePackage{fancyhdr}

% Page layout (close to Awesome-CV defaults)
\geometry{left=1.2cm, top=.8cm, right=1.2cm, bottom=1.8cm}

% Typography
\RequirePackage[default,semibold]{sourcesanspro}
\renewcommand{\familydefault}{\sfdefault}
\setlength{\parindent}{0pt}

% Colors
\definecolor{cvaccent}{HTML}{DC3522} % awesome-red
\definecolor{cvtext}{HTML}{333333}
\definecolor{cvmuted}{HTML}{5D5D5D}
\definecolor{cvlight}{HTML}{999999}

% Shared core macro customization
\renewcommand{\cvHuggingFaceBadgeColor}{cvaccent}

\hypersetup{colorlinks=true, urlcolor=cvaccent}

% Optional header font (Roboto vendored via fonts/)
\providecommand{\cvheaderfont}{\sffamily}
\providecommand{\cvheaderfontlight}{\sffamily}

\IfFileExists{fonts/Roboto-Regular.ttf}{%
    \newfontfamily\cvheaderfontRoboto[
        Path=fonts/,
        UprightFont=*-Regular,
        ItalicFont=*-Italic,
        BoldFont=*-Bold,
        BoldItalicFont=*-BoldItalic,
    ]{Roboto}%
    \renewcommand{\cvheaderfont}{\cvheaderfontRoboto}%
}{}

\IfFileExists{fonts/Roboto-Thin.ttf}{%
    \newfontfamily\cvheaderfontRobotoLight[
        Path=fonts/,
        UprightFont=*-Thin,
        ItalicFont=*-ThinItalic,
        BoldFont=*-Medium,
        BoldItalicFont=*-MediumItalic,
    ]{Roboto}%
    \renewcommand{\cvheaderfontlight}{\cvheaderfontRobotoLight}%
}{}

% Spacing knobs (roughly aligned with Awesome-CV)
\newcommand{\cvHeaderSocialSep}{\quad\textbar\quad}
\newcommand{\cvHeaderAfterSocialSkip}{0.35em}
\newcommand{\cvHeaderAfterQuoteSkip}{0.6em}

% Vertical spacing before a section title.
% We keep the first section tighter because it follows the header.
\newlength{\cvSectionPreSkip}
\setlength{\cvSectionPreSkip}{0.9em}
\newlength{\cvSectionFirstPreSkip}
\setlength{\cvSectionFirstPreSkip}{0.25em}
\newif\ifcvfirstsectionafterheader
\cvfirstsectionafterheaderfalse

% Highlight first 3 letters in section titles
\newbool{cvSectionColorHighlight}
\setbool{cvSectionColorHighlight}{true}
\def\cvsectioncolor#1#2#3{%
    \ifbool{cvSectionColorHighlight}{{\color{cvaccent}#1#2#3}}{#1#2#3}%
}

% Column helpers (Awesome-CV-style)
\newcolumntype{L}[1]{>{\RaggedRight\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}
\newcolumntype{R}[1]{>{\RaggedLeft\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}

\makeatletter
\def\cvhrulefill#1{\leavevmode\leaders\hrule\@height#1\hfill\kern\z@}
\makeatother

%-------------------------------------------------------------------------------
% Header / Footer
%-------------------------------------------------------------------------------
\newcommand{\cvmakeheader}{%
    \begingroup
    \setlength{\parskip}{0pt}%
    \thispagestyle{empty}%
    \noindent
    \begin{minipage}[c]{0.76\textwidth}
        \raggedright
        \shortstack[l]{%
            {\fontsize{32pt}{1em}\selectfont\cvheaderfontlight\color{cvlight} \contactfirstname}%
            {\fontsize{32pt}{1em}\selectfont\cvheaderfont\bfseries\color{cvtext}~\contactlastname}\\[0.35em]%
            \ifdefempty{\contactrole}{}{{\fontsize{8pt}{1em}\selectfont\sourcesanspro\scshape\color{cvaccent} \contactrole}\\[0.35em]}%
            \ifdefempty{\contactcity}{}{{\fontsize{8pt}{1em}\selectfont\cvheaderfont\itshape\color{cvlight} \contactcity}\\[-0.1em]}%
            {\fontsize{6.8pt}{1em}\selectfont\cvheaderfont\color{cvtext}%
                % Two-line contact block (keeps the header compact on A4)
                \newbool{cv@hasrowtwo}%
                \setbool{cv@hasrowtwo}{false}%
                \ifdefempty{\contactgithub}{}{\setbool{cv@hasrowtwo}{true}}%
                \ifdefempty{\contactlinkedin}{}{\setbool{cv@hasrowtwo}{true}}%
                \ifdefempty{\contacthuggingfaceurl}{}{\setbool{cv@hasrowtwo}{true}}%
                \parbox[t]{\linewidth}{%
                    \mbox{\newbool{cv@isstartone}%
                        \setbool{cv@isstartone}{true}%
                        \ifdefempty{\contactphone}{}{\ifbool{cv@isstartone}{}{\cvHeaderSocialSep}\faMobile\,\contactphone\setbool{cv@isstartone}{false}}%
                        \ifdefempty{\contactemail}{}{\ifbool{cv@isstartone}{}{\cvHeaderSocialSep}\href{mailto:\contactemail}{\faEnvelope\,\contactemail}\setbool{cv@isstartone}{false}}%
                    \ifdefempty{\contactportfoliohomepage}{}{\ifbool{cv@isstartone}{}{\cvHeaderSocialSep}\href{\contactportfoliourl}{\faHome\,\contactportfoliohomepage}\setbool{cv@isstartone}{false}}}%
                    \ifbool{cv@hasrowtwo}{\\[0.25em]\mbox{\newbool{cv@isstarttwo}%
                            \setbool{cv@isstarttwo}{true}%
                            \ifdefempty{\contactgithub}{}{\ifbool{cv@isstarttwo}{}{\cvHeaderSocialSep}\href{https://github.com/\contactgithub}{\faGithubSquare\,\contactgithub}\setbool{cv@isstarttwo}{false}}%
                            \ifdefempty{\contactlinkedin}{}{\ifbool{cv@isstarttwo}{}{\cvHeaderSocialSep}\href{https://www.linkedin.com/in/\contactlinkedin}{\faLinkedinSquare\,\contactlinkedin}\setbool{cv@isstarttwo}{false}}%
                    \ifdefempty{\contacthuggingfaceurl}{}{\ifbool{cv@isstarttwo}{}{\cvHeaderSocialSep}\href{\contacthuggingfaceurl}{\cvHuggingFaceIcon\,\contacthuggingfacelabel}}}}{}%
                }%
            }\\[\cvHeaderAfterSocialSkip]%
            \ifdefempty{\contactquote}{}{{\fontsize{9pt}{1em}\selectfont\sourcesanspro\itshape\color{cvtext} ``\contactquote''}\\[\cvHeaderAfterQuoteSkip]}%
        }%
    \end{minipage}%
    \begin{minipage}[c]{0.24\textwidth}
        \raggedleft
        \IfFileExists{profile.png}{%
            \begingroup
            \setlength{\fboxsep}{0pt}%
            \setlength{\fboxrule}{0.3pt}%
            \fcolorbox{cvlight}{white}{\includegraphics[width=2.8cm]{profile.png}}%
            \endgroup
        }{}%
    \end{minipage}%
    \global\cvfirstsectionafterheadertrue
    \endgroup
}

\newcommand*{\cvfooterstyle}[1]{{\fontsize{8pt}{1em}\selectfont\sourcesanspro\scshape\color{cvlight} #1}}

\newcommand*{\makecvfooter}[3]{%
    \pagestyle{fancy}%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
    \fancyfoot[L]{\cvfooterstyle{#1}}%
    \fancyfoot[C]{\cvfooterstyle{#2}}%
    \fancyfoot[R]{\cvfooterstyle{#3}}%
}

%-------------------------------------------------------------------------------
% Unified semantic markup
%-------------------------------------------------------------------------------
% Optional argument sets \cventrysep for this section:
%   \cvsection[0.6em]{Education}
\newcommand{\cvsection}[2][]{%
    \ifstrempty{#1}{\cvresetcventrysep}{\cvsetcventrysep{#1}}%
    \ifcvfirstsectionafterheader
        \global\cvfirstsectionafterheaderfalse
        \vspace{\cvSectionFirstPreSkip}%
    \else
        \vspace{\cvSectionPreSkip}%
    \fi
    \noindent{\Large\bfseries\color{cvtext}\cvsectioncolor #2}%
    \hspace{0.7em}%
    {\color{cvmuted}\cvhrulefill{0.9pt}}%
    \par\vspace{0.4em}%
}

\newcommand{\cvsubsection}[1]{%
    \vspace{0.6em}%
    {\normalsize\bfseries\scshape\color{cvtext}#1}\par
}

\newenvironment{cventries}{\vspace{0.2em}}{\vspace{0.2em}}

% \cventry{<position>}{<title/org>}{<location>}{<date>}{<desc>}
\newcommand*{\cventry}[5]{%
    \vspace{-1.2mm}%
    \setlength{\tabcolsep}{0pt}%
    \ifstrempty{#2}{%
        % Fallback layout: allow using only "position" (#1) + date (#4).
        % Used by sections like Projects/Activities where we want a compact entry.
        \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} L{\dimexpr\textwidth-4.5cm\relax} R{4.5cm}}
            {\fontsize{10pt}{1em}\selectfont\bfseries\color{cvtext}#1} & {\fontsize{8pt}{1em}\selectfont\slshape\color{cvmuted}#4}\\
            \multicolumn{2}{L{\textwidth}}{#5}%
        \end{tabular*}%
    }{%
        \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} L{\dimexpr\textwidth-4.5cm\relax} R{4.5cm}}
            {\fontsize{10pt}{1em}\selectfont\bfseries\color{cvtext}#2} & {\fontsize{9pt}{1em}\selectfont\itshape\color{cvaccent}#3}\\
            {\fontsize{8pt}{1em}\selectfont\scshape\color{cvmuted}#1} & {\fontsize{8pt}{1em}\selectfont\slshape\color{cvmuted}#4}\\
            \multicolumn{2}{L{\textwidth}}{#5}%
        \end{tabular*}%
    }%
    \vspace{\cventrysep}%
}

\newenvironment{cvitems}{%
    \vspace{-2mm}%
    \begin{itemize}[
                leftmargin=2ex,
                topsep=0pt,
                partopsep=0pt,
                parsep=0pt,
                itemsep=\cvitemssep
            ]
            \setlength{\parskip}{0pt}%
            \renewcommand{\labelitemi}{\textbullet}%
            \small\color{cvmuted}%
        }{%
    \end{itemize}%
    \vspace{-1mm}%
}

\newenvironment{cvparagraph}{\small\color{cvmuted}}{\par\vspace{0.2em}}

\newenvironment{cvskills}{%
    \vspace{0.2em}%
    \setlength{\tabcolsep}{1ex}%
    \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} L{0.27\textwidth} L{0.70\textwidth}}
    }{
\end{tabular*}}

\newcommand*{\cvskill}[2]{%
    {\fontsize{10pt}{1em}\selectfont\bfseries\color{cvtext}#1} & {\fontsize{9pt}{1em}\selectfont\color{cvtext}#2}\\
}

%-------------------------------------------------------------------------------
% Education-specific semantic macros
%-------------------------------------------------------------------------------
% Education details (single bullet or bullet list)
\newcommand{\cvedudetails}[1]{
    \begin{cvitems}
    \item {#1}
\end{cvitems}}
\newenvironment{cvedudetailslist}{
\begin{cvitems}}{
\end{cvitems}}
\newcommand{\cvedudetail}[1]{
\item {#1}}

\newcommand*{\cveduentry}[5]{%
    \cventry{#1}{#2}{#3}{#4}{%
        \ifstrempty{#5}{}{#5}%
    }%
    % Tighter spacing between education entries than work experience
    \vspace{-0.3em}%
}

\newcommand*{\cvaward}[3]{%
    \cventry{#1}{#2}{}{#3}{}%
    % Keep awards list tight as well
    \vspace{-0.3em}%
}

% Honors list (used by some sections)
\newcolumntype{C}[1]{>{\Centering\let\newline\\\arraybackslash\hspace{0pt}}m{#1}}

\newenvironment{cvhonors}{%
    \vspace{0.2em}%
    \setlength{\tabcolsep}{0pt}%
    \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} C{1.5cm} L{\dimexpr\textwidth-4.0cm\relax} R{2.5cm}}
    }{
\end{tabular*}}

\newcommand*{\cvhonor}[4]{%
    {\fontsize{9pt}{1em}\selectfont\color{cvmuted}#4} &
    {\fontsize{9pt}{1em}\selectfont\bfseries\color{cvtext}#1, \normalfont\color{cvmuted}#2} &
    {\fontsize{9pt}{1em}\selectfont\slshape\color{cvaccent}#3}\\
}
