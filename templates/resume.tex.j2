\documentclass[12pt,a4paper]{resume}

{% macro render_summary(text) %}
\cvbody[lead]{ {{ text | latex_escape }} }
{% endmacro %}

{% macro render_experience(items) %}
\cvsectiontitle[{{ 'sidebar' if layout == 'twocol' else 'standard' }}]{Experience}
{% for exp in items %}
{% if not loop.first %}\vspace{ {{- theme.rules.entry_spacing -}} }{% endif %}
\par\cventry
  { {{ exp.role | latex_escape }} }
  { {{ exp.start | format_date }}-{{ exp.end | default('present') | format_date }} }
  { {{ exp.company | latex_escape }} }
  {}
{% for h in exp.highlights %}
\cvsmall[detail]{$\bullet$ {{ h | latex_escape }}}\\
{% endfor %}
{% endfor %}
{% endmacro %}

{% macro render_education(items) %}
\cvsectiontitle[{{ 'sidebar' if layout == 'twocol' else 'standard' }}]{Education}
{% for edu in items %}
{% if not loop.first %}\vspace{ {{- theme.rules.entry_spacing -}} }{% endif %}
\par\cventry
  { {{ edu.degree | latex_escape }} }
  { {{ edu.year | string | latex_escape }} }
  { {{ edu.institution | latex_escape }} }
  {}
{% for detail in edu.details | default([]) %}
\cvsmall[detail]{$\bullet$ {{ detail | latex_escape }}}\\
{% endfor %}
{% endfor %}
{% endmacro %}

{% macro render_publications(items) %}
\cvsectiontitle[{{ 'sidebar' if layout == 'twocol' else 'standard' }}]{Publications}
{% for paper in items %}
\par\cventry[inline]
  { {% if paper.url %}\href{ {{ paper.url }} }{ {{ paper.title | latex_escape }} }{% else %}{{ paper.title | latex_escape }}{% endif %} }
  { {{ paper.year | string | latex_escape }} }
  { {{ paper.venue | default('') | latex_escape }} }
  {}
{% endfor %}
{% endmacro %}

{% macro render_projects(items) %}
\cvsectiontitle[{{ 'sidebar' if layout == 'twocol' else 'standard' }}]{Projects}
{% for project in items %}
\par\cventry[stacked]
  { {{ project.title | latex_escape }} }
  {}
  { {{ project.details | default('') | latex_escape }} }
  {}
{% endfor %}
{% endmacro %}

{% macro render_skills(items) %}
\cvsectiontitle[{{ 'sidebar' if layout == 'twocol' else 'standard' }}]{Skills}
{% for group in items %}
\cvskill[{{ 'compact' if layout == 'twocol' else 'standard' }}]{ {{ group.category | latex_escape }} }{ {{ group['items'] | join(', ') | latex_escape }} }
{% endfor %}
{% endmacro %}

{% macro render_languages(items) %}
{% if items %}
\cvsectiontitle[{{ 'sidebar' if layout == 'twocol' else 'standard' }}]{Languages}
{% for language in items %}
\cvskill[standard]{ {{ language.name | latex_escape }} }{ {{ language.level | latex_escape }} }
{% endfor %}
{% endif %}
{% endmacro %}

\begin{document}

\begin{minipage}[c]{0.82\textwidth}
\cvname[hero]{ {{ meta.name | latex_escape }} }\\[4pt]
\cvtitle[headline]{ {{ meta.title | latex_escape }} }\\[4pt]
\cvmeta{ {{ meta.email }} ~|~ {{ meta.phone | latex_escape }} ~|~ {{ meta.location | latex_escape }} }\\
\cvmeta[links]{ \raisebox{-0.1em}{\includegraphics[height=0.8em]{linkedin}} linkedin.com/in/{{ meta.linkedin | latex_escape }} ~|~ \raisebox{-0.1em}{\includegraphics[height=0.8em]{github}} github.com/{{ meta.github | latex_escape }} ~|~ \raisebox{-0.1em}{\includegraphics[height=0.8em]{huggingface}} hf.co/{{ meta.huggingface | latex_escape }} }\\
\cvmeta[links]{ {{ meta.portfolio | latex_escape }} }
\end{minipage}%
\hfill
\begin{minipage}[c]{0.15\textwidth}
\raggedleft
\includegraphics[width=\linewidth,clip,trim=0 0 0 0]{profile.png}
\end{minipage}

\vspace{12pt}

{% if layout == 'single' %}
{% if summary and meta.show_summary != false %}{{- render_summary(summary) }}{% endif %}
{{- render_experience(experience) }}
{{- render_education(education) }}
{{- render_publications(publications | default([])) }}
{{- render_projects(projects | default([])) }}
{{- render_skills(skills) }}
{{- render_languages(languages | default([])) }}
{% elif layout == 'twocol' %}
\begin{paracol}{2}
{{- render_skills(skills) }}
{{- render_languages(languages | default([])) }}
{{- render_education(education) }}
\switchcolumn
{% if summary and meta.show_summary != false %}{{- render_summary(summary) }}{% endif %}
{{- render_experience(experience) }}
{{- render_publications(publications | default([])) }}
{{- render_projects(projects | default([])) }}
\end{paracol}
{% elif layout == 'twocol-footer' %}
\begin{paracol}{2}
{{- render_skills(skills) }}
{{- render_languages(languages | default([])) }}
{{- render_education(education) }}
\switchcolumn
{% if summary and meta.show_summary != false %}{{- render_summary(summary) }}{% endif %}
{{- render_experience(experience) }}
\end{paracol}
{{- render_publications(publications | default([])) }}
{{- render_projects(projects | default([])) }}
{% endif %}

\end{document}
