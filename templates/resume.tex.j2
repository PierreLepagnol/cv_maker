\documentclass[11pt,a4paper]{resume}

{% set is_two_column = layout in ['twocol', 'twocol-footer'] %}

{% macro render_summary(text) %}
\cvbody[lead]{ {{ text | latex_escape }} }
{% endmacro %}

{% macro render_experience(items) %}
\cvsectiontitle[{{ 'aside' if is_two_column else 'base' }}][{{ 'sidebar' if is_two_column else 'standard' }}]{Experience}
{% for exp in items %}
{% if not loop.first %}\cvblocksep{ {{- theme.rules.block_spacing -}} }{% endif %}
\par\cventry[base][standard]
  { {{ exp.role | latex_escape }} }
  { {{ exp.start | format_date }}-{{ exp.end | default('present') | format_date }} }
  { {{ exp.company | latex_escape }} }
  {}
{% for h in exp.highlights | default([]) %}
\cvsmall[detail]{$\bullet$ {{ h | latex_escape }}}\\
{% endfor %}
{% endfor %}
{% endmacro %}

{% macro render_education(items) %}
\cvsectiontitle[{{ 'aside' if is_two_column else 'base' }}][{{ 'sidebar' if is_two_column else 'standard' }}]{Education}
{% for edu in items %}
{% if not loop.first %}\cvblocksep{ {{- theme.rules.block_spacing -}} }{% endif %}
\par\cventry[base][standard]
  { {{ edu.degree | latex_escape }} }
  { {{ edu.year | string | latex_escape }} }
  { {{ edu.institution | latex_escape }} }
  {}
{% for detail in edu.details | default([]) %}
\cvsmall[detail]{$\bullet$ {{ detail | latex_escape }}}\\
{% endfor %}
{% endfor %}
{% endmacro %}

{% macro render_publications(items) %}
\cvsectiontitle[{{ 'aside' if is_two_column else 'base' }}][{{ 'sidebar' if is_two_column else 'standard' }}]{Publications}
{% for paper in items %}
{% if not loop.first %}\cvblocksep{ {{- theme.rules.block_spacing -}} }{% endif %}
\par\cventry[base][inline]
  { {% if paper.url | default('') %}\href{ {{ paper.url }} }{ {{ paper.title | latex_escape }} }{% else %}{{ paper.title | latex_escape }}{% endif %} }
  { {{ paper.year | string | latex_escape }} }
  { {{ paper.venue | default('') | latex_escape }} }
  {}
{% endfor %}
{% endmacro %}

{% macro render_projects(items) %}
\cvsectiontitle[{{ 'aside' if is_two_column else 'base' }}][{{ 'sidebar' if is_two_column else 'standard' }}]{Projects}
{% for project in items %}
{% if not loop.first %}\cvblocksep{ {{- theme.rules.project_spacing -}} }{% endif %}
\par\cventry[base][stacked]
  { {{ project.title | latex_escape }} }
  {}
  { {{ project.details | default('') | latex_escape }} }
  {}
{% endfor %}
{% endmacro %}

{% macro render_skills(items) %}
\cvsectiontitle[{{ 'aside' if is_two_column else 'base' }}][{{ 'sidebar' if is_two_column else 'standard' }}]{Skills}
{% for group in items %}
\cvskill[{{ 'aside' if is_two_column else 'base' }}][{{ 'stacked' if is_two_column else 'inline' }}]{ {{ group.category | latex_escape }} }{ {{ group['items'] | join(', ') | latex_escape }} }
{% endfor %}
{% endmacro %}

{% macro render_languages(items) %}
{% if items %}
\cvsectiontitle[{{ 'aside' if is_two_column else 'base' }}][{{ 'sidebar' if is_two_column else 'standard' }}]{Languages}
{% for language in items %}
\cvskill[base][inline]{ {{ language.name | latex_escape }} }{ {{ language.level | latex_escape }} }
{% endfor %}
{% endif %}
{% endmacro %}

\begin{document}

{% set contact_parts = [] %}
{% if meta.email | default('') %}{% set contact_parts = contact_parts + [meta.email] %}{% endif %}
{% if meta.phone | default('') %}{% set contact_parts = contact_parts + [meta.phone | latex_escape] %}{% endif %}
{% if meta.location | default('') %}{% set contact_parts = contact_parts + [meta.location | latex_escape] %}{% endif %}
{% set link_parts = [] %}
{% if meta.linkedin | default('') %}{% set link_parts = link_parts + ['\\raisebox{-0.1em}{\\includegraphics[height=0.8em]{linkedin}} linkedin.com/in/' ~ (meta.linkedin | latex_escape)] %}{% endif %}
{% if meta.github | default('') %}{% set link_parts = link_parts + ['\\raisebox{-0.1em}{\\includegraphics[height=0.8em]{github}} github.com/' ~ (meta.github | latex_escape)] %}{% endif %}
{% if meta.huggingface | default('') %}{% set link_parts = link_parts + ['\\raisebox{-0.1em}{\\includegraphics[height=0.8em]{huggingface}} hf.co/' ~ (meta.huggingface | latex_escape)] %}{% endif %}

\begin{minipage}[c]{0.82\textwidth}
\cvname[hero]{ {{ meta.name | latex_escape }} }\\[{{ theme.rules.header_gap }}]
{% if meta.title | default('') %}
\cvtitle[headline]{ {{ meta.title | latex_escape }} }\\[{{ theme.rules.header_gap }}]
{% endif %}
{% if contact_parts %}
\cvmeta{ {{ contact_parts | join(' ~|~ ') }} }\\
{% endif %}
{% if link_parts %}
\cvmeta[links]{ {{ link_parts | join(' ~|~ ') }} }\\
{% endif %}
{% if meta.portfolio | default('') %}
\cvmeta[links]{ {{ meta.portfolio | latex_escape }} }
{% endif %}
\end{minipage}%
\hfill
\begin{minipage}[c]{0.15\textwidth}
\raggedleft
\includegraphics[width=\linewidth,clip,trim=0 0 0 0]{profile.png}
\end{minipage}

\vspace{ {{- theme.rules.header_bottom_gap -}} }

{% if layout == 'single' %}
{% if summary | default('') and meta.show_summary | default(true) != false %}{{- render_summary(summary) }}{% endif %}
{{- render_experience(experience) }}
{{- render_education(education) }}
{{- render_publications(publications | default([])) }}
{{- render_projects(projects | default([])) }}
{{- render_skills(skills) }}
{{- render_languages(languages | default([])) }}
{% elif layout == 'twocol' %}
\begin{paracol}{2}
{{- render_skills(skills) }}
{{- render_languages(languages | default([])) }}
{{- render_education(education) }}
\switchcolumn
{% if summary | default('') and meta.show_summary | default(true) != false %}{{- render_summary(summary) }}{% endif %}
{{- render_experience(experience) }}
{{- render_publications(publications | default([])) }}
{{- render_projects(projects | default([])) }}
\end{paracol}
{% elif layout == 'twocol-footer' %}
\begin{paracol}{2}
{{- render_skills(skills) }}
{{- render_languages(languages | default([])) }}
{{- render_education(education) }}
\switchcolumn
{% if summary | default('') and meta.show_summary | default(true) != false %}{{- render_summary(summary) }}{% endif %}
{{- render_experience(experience) }}
\end{paracol}
{{- render_publications(publications | default([])) }}
{{- render_projects(projects | default([])) }}
{% endif %}

\end{document}
